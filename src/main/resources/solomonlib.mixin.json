{
	"required": true,
	"minVersion": "0.8",
	"package": "com.min01.solomonlib.mixin",
	"plugin": "com.min01.solomonlib.misc.SolomonMixinPlugin",
	"compatibilityLevel": "JAVA_17",
	"mixins": [
		"packet.MixinFriendlyByteBuf",
		"packet.MixinCompressionDecoder",
		"packet.MixinClientboundCustomPayloadPacket",
		"packet.MixinServerboundCustomPayloadPacket",
		"multipart.MixinEntity",
		"multipart.MixinLevel",
		"multipart.MixinLevelReader"
	],
	"client": [
		"multipart.MixinEntityRenderDispatcher"
	],
	"server": [
	],
	"injectors": {
		"defaultRequire": 1
	},
	"overwrites": {
		"requireAnnotations": true
	},
	"refmap": "solomonlib.refmap.json"
}
